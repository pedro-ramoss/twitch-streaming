      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.75,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "twitch-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(NULLIF(game_name, ''), 'Sem jogo') AS jogo, COUNT(*)::bigint AS snapshots FROM public.stream_snapshots WHERE $__timeFilter(collected_at) GROUP BY 1 ORDER BY snapshots DESC LIMIT 10"
        }
      ]
    },
