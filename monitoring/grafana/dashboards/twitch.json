          "rawSql": "SELECT COALESCE(NULLIF(user_name, ''), user_id, 'Desconhecido') AS streamer, COUNT(*)::bigint AS snapshots, MAX(viewer_count)::bigint AS pico_espectadores FROM public.stream_snapshots WHERE $__timeFilter(collected_at) GROUP BY 1 ORDER BY snapshots DESC LIMIT 10"
