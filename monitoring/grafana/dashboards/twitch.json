          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT collected_at AS \"Coletado em\", user_name AS \"Streamer\", game_name AS \"Jogo\", viewer_count AS \"Espectadores\", stream_id AS \"Stream ID\" FROM public.stream_snapshots WHERE $__timeFilter(collected_at) ORDER BY collected_at DESC LIMIT 25"
        }
